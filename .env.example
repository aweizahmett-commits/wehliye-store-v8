# Local development only. Copy to a private .env. Never commit credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
ADMIN_USER=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3001
# Optional local port; Render supplies PORT.
# PORT=3001
# Default 0 ignores forwarded headers; verify the proxy chain before changing.
TRUST_PROXY_HOPS=0

# Render private runtime settings:
# NODE_ENV=production
# DATABASE_URL=<existing database Internal Database URL from Render Dashboard>
# PUBLIC_URL=https://wehliye-store-v8.onrender.com
# Set the admin and Google values above privately in Render.
